		<resources>

			<!-- Move All Resources stored with Java Sources -->
			<resource>
				<filtering>false</filtering>
				<directory>${basedir}/src/main/java</directory>
				<includes>
					<include>**/*.fxml</include>
					<include>**/*.properties</include>
					<include>**/*.txt</include>
				</includes>
			</resource>

			<!-- Move All Resources (except Fonts) to Module folder with filtering -->
			<resource>
				<filtering>true</filtering>
				<directory>${basedir}/src/main/resources</directory>
				<targetPath>${project.build.outputDirectory}/${resources.base.path}</targetPath>
				<includes>
					<include>**/*.*</include>
				</includes>
				<excludes>
					<exclude>root/**</exclude>
					<exclude>**/*.ttf</exclude>
					<exclude>**/*.otf</exclude>
					<exclude>**/*.ico</exclude>
				</excludes>
			</resource>

			<!-- Move All Fonts to Module folder without filtering -->
			<resource>
				<filtering>false</filtering>
				<directory>${basedir}/src/main/resources</directory>
				<targetPath>${project.build.outputDirectory}/${resources.base.path}</targetPath>
				<includes>
					<include>**/*.ttf</include>
					<include>**/*.otf</include>
					<include>**/*.ico</include>
				</includes>
			</resource>

			<!-- Move All Resources that shall be at Root level into Jar (ie: META-INF folder) -->
			<resource>
				<filtering>false</filtering>
				<directory>${basedir}/src/main/resources/root</directory>
				<includes>
					<include>**/*.*</include>
				</includes>
			</resource>
		</resources>

