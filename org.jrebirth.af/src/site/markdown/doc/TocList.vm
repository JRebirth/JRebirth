#*
## Display Full Table of Content
*#
#macro( displayToc )

<ol>
#foreach( $item in $items )
    <li><a href="${item.link}.html" >${item.name}</a></li>
#end
</ol>

#end

#*
## Display Foot links
*#
#macro( displayFooterToc $fileName )

	#set($foundIndex = false)
	#set($indexVal = 0)
	#set($counter = 0)
	#foreach( $item in $items )
		#if ($item.link == $fileName)
			#set($foundIndex = true)
			#set($indexVal = $counter)
		#end
		#set($counter = $counter + 1)
	#end
	
#if( $foundIndex )
	#set( $previous = $indexVal - 1 )
	#set( $next = $indexVal + 1 )
	
<div class="bottomLinks">
#if( $previous >= 0 )
	<div class="previousDocPage">
		<a href="${items.get($previous).link}.html">${items.get($previous).name}</a>
	</div>
#end	
#if( $next < $items.size() )
	<div class="nextDocPage">
		<a href="${items.get($next).link}.html">${items.get($next).name}</a>
	</div>
#end
	<div class="tocDocPage">
		<a href="Toc.html">TOC</a>
	</div>
</div>
#end

#end