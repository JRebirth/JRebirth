<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2 http://maven.apache.org/xsd/assembly-1.1.2.xsd">

	<id>framework-bundle</id>
	<formats>
		<format>zip</format>
	</formats>

	<includeBaseDirectory>true</includeBaseDirectory>
	<baseDirectory>JRebirth-${project.version}</baseDirectory>

	<fileSets>
		<fileSet>
			<directory>..</directory>
			<outputDirectory>/</outputDirectory>
			<includes>
				<include>README.md</include>
				<include>LICENSE*</include>
			</includes>
		</fileSet>
		<!-- After `mvn install` on library modules (see release-version skill). Works with `mvn site -N`. -->
		<fileSet>
			<directory>${project.basedir}</directory>
			<outputDirectory>libs</outputDirectory>
			<includes>
				<include>**/target/*-${project.version}.jar</include>
				<include>**/target/*-${project.version}-sources.jar</include>
			</includes>
			<excludes>
				<exclude>showcase/**</exclude>
				<exclude>sample/**</exclude>
				<exclude>distribution/**</exclude>
				<exclude>**/*-tests.jar</exclude>
				<exclude>**/*-javadoc.jar</exclude>
				<exclude>**/original-*.jar</exclude>
			</excludes>
			<useDefaultExcludes>true</useDefaultExcludes>
		</fileSet>
	</fileSets>

</assembly>