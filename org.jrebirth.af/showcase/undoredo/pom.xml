<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.jrebirth.af</groupId>
		<artifactId>showcase</artifactId>
		<version>12.0.1-SNAPSHOT</version>
		<relativePath>..</relativePath>
	</parent>

	<groupId>org.jrebirth.af.showcase</groupId>
	<artifactId>undoredo</artifactId>
	<packaging>jar</packaging>

	<name>SC Undo Redo</name>
	<description>Showcase application used to describe Undo Redo features</description>


	<properties>
		<appClass>${project.groupId}.${project.artifactId}.UndoRedoApplication</appClass>
		<mainModule>org.jrebirth.af.showcase.undoredo</mainModule>
		<archiveName>UndoRedo</archiveName>
		<deployPath>undoredo/${project.version}</deployPath>
		<exeIcon>src/main/resources/images/JRebirth_64x64.ico</exeIcon>
		<resources.base.path>org/jrebirth/af/showcase/undoredo</resources.base.path>
	</properties>

	<dependencies>

		<dependency>
			<groupId>org.jrebirth.af</groupId>
			<artifactId>undoredo</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.jrebirth.af</groupId>
			<artifactId>processor</artifactId>
			<version>${project.version}</version>
			<scope>provided</scope>
		</dependency>
	</dependencies>

	<url>http://www.jrebirth.org/apps/UndoRedo.html</url>
<profiles>
		<profile>
			<id>PackageApp</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.openjfx</groupId>
						<artifactId>javafx-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>jlink</id>
								<phase>package</phase>
								<goals><goal>jlink</goal></goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-shade-plugin</artifactId>
						<executions>
							<execution>
								<id>shade</id>
								<phase>package</phase>
								<goals><goal>shade</goal></goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>com.akathist.maven.plugins.launch4j</groupId>
						<artifactId>launch4j-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>launch4j</id>
								<phase>package</phase>
								<goals><goal>launch4j</goal></goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>DeployApps</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>wagon-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>deploy-jlink-zip</id>
								<phase>site-deploy</phase>
								<goals><goal>upload-single</goal></goals>
								<configuration>
									<fromFile>${project.build.directory}/${archiveName}.zip</fromFile>
									<toFile>${deployPath}/${archiveName}-${project.version}.zip</toFile>
								</configuration>
							</execution>
							<execution>
								<id>deploy-winexe</id>
								<phase>site-deploy</phase>
								<goals><goal>upload-single</goal></goals>
								<configuration>
									<fromFile>${project.build.directory}/${archiveName}-${project.version}.exe</fromFile>
									<toFile>${deployPath}/${archiveName}-${project.version}.exe</toFile>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
